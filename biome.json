{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},

	"files": {
		"ignoreUnknown": true
	},

	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},

	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off",
				"noConsole": {
					"level": "error",
					"options": {
						"allow": ["warn", "error", "info"]
					}
				}
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": "error"
			},
			"complexity": {
				"useOptionalChain": "off"
			}
		}
	},

	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},

	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"globals": ["figma", "__html__"]
	},

	"overrides": [
		{
			"includes": [".output/**"],
			"formatter": { "enabled": false },
			"linter": { "enabled": false },
			"assist": { "enabled": false }
		}
	]
}
